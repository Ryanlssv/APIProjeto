<ContentPage
    x:Class="APIProjeto.FotosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Fotos">
    <Grid RowDefinitions="Auto,*" Padding="16">
        <Label
            x:Name="TituloFotos"
            Grid.Row="0"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            Margin="0,8,0,16" />
        <CollectionView x:Name="ListaFotos" Grid.Row="1">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma foto encontrada." HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0" Margin="0,0,0,12">
                        <Image Source="{Binding}" HeightRequest="200" Aspect="AspectFill" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
